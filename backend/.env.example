# Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env — it is in .gitignore

# Server
PORT=5001

# JWT
JWT_SECRET=supersecretenterprisekey

# MySQL Database
# These are currently hard-coded in backend/config/db.js for local development.
# Override here for your environment.
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=voltguard_db
